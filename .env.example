# ===== DoorSurvey Pro - Environment Variables Template =====
# Copy to .env for local development or configure in Replit Secrets for deployment
# NEVER commit actual secrets to version control

# ===== Application Environment =====
NODE_ENV=development

# ===== Database (PostgreSQL via Neon) =====
# Auto-configured on Replit, or use your own PostgreSQL instance
DATABASE_URL=postgresql://user:password@host:5432/doorsurvey_pro
PGHOST=your-db-host.neon.tech
PGPORT=5432
PGUSER=your-db-user
PGPASSWORD=your-db-password
PGDATABASE=doorsurvey_pro

# ===== Authentication & Security =====
# Session encryption key (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secure-random-session-secret-min-32-chars

# Replit OIDC Authentication (auto-configured on Replit)
OIDC_ISSUER_URL=https://replit.com/oidc
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret

# Replit Platform Variables (auto-configured)
REPL_ID=your-repl-id
REPLIT_DEPLOYMENT=1

# Nonce verification for anti-bot protection (REQUIRED for multi-instance deployments)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NONCE_SECRET=your-64-character-hex-string-for-nonce-signing

# Admin credentials for protected routes
ADMIN_USER=admin
ADMIN_PASS=secure-admin-password

# ===== Redis (Optional - Recommended for Production) =====
# Used for distributed cache and job queue
# Falls back to in-memory if not configured
REDIS_URL=redis://localhost:6379
# OR use individual parameters:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ===== NATS Message Bus (Optional - Required for Worker Architecture) =====
# Used for event-driven async processing (photo enrichment, compliance validation)
# Falls back to in-memory event queue if not configured (workers won't receive events)
NATS_URL=nats://localhost:4222
# For production, use NATS cluster:
# NATS_URL=nats://nats1:4222,nats2:4222,nats3:4222

# ===== Payment Processing (Stripe) =====
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# ===== Email Service (Resend) =====
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ===== AI Services (OpenAI via Replit AI Integrations) =====
# Auto-configured via Replit AI Integrations - preferred method
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key

# ===== Error Tracking (Sentry) =====
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
# Backend DSN (private - server-side only)
SENTRY_DSN=https://YOUR_BACKEND_KEY@o0.ingest.sentry.io/PROJECT_ID
# Frontend DSN (public - exposed to browsers)
VITE_SENTRY_DSN=https://YOUR_FRONTEND_KEY@o0.ingest.sentry.io/PROJECT_ID

# ===== CRM Integration (HubSpot) =====
# Get API key from: https://app.hubspot.com/settings/integrations/api-keys
HUBSPOT_API_KEY=your-hubspot-api-key

# ===== Python Service (LiDAR Processing) =====
# URL to external Python service for advanced 3D processing
PYTHON_SERVICE_URL=http://localhost:8000

# ===== Google Drive / Docs / Sheets (Service Account) =====
# Create service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable APIs: Drive, Docs, Sheets
# IMPORTANT: Escape newlines in private key as \n for Node.js
GOOGLE_CLIENT_EMAIL=svc-door-survey@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n
# Scopes used: drive, documents, spreadsheets

# ===== Jira Cloud (Direct API) =====
# Create API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Note: Replit connector available - see integrations page for managed approach
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=DSP

# ===== Confluence Cloud (Direct API) =====
# Note: Replit connector available - see integrations page for managed approach
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=DSP

# ===== Asana =====
# Get Personal Access Token from: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=1/your_asana_personal_access_token
ASANA_WORKSPACE_ID=1234567890
ASANA_PROJECT_ID=1234567890

# ===== Figma =====
# Get Personal Access Token from: https://www.figma.com/developers/api#access-tokens
FIGMA_PERSONAL_TOKEN=figd_YourFigmaPersonalAccessToken
FIGMA_FILE_KEY=AbCdEfGhIjKlMnOpQrStUv
FIGMA_TEAM_ID=1234567

# ===== Replit Managed Integrations =====
# The following integrations are available via Replit's connector system
# and don't require manual API key management:
#
# - Jira (connector:ccfg_jira_8D0B4B1730F64429A4FC3ACB88)
# - Confluence (connector:ccfg_confluence_38283C8EB5984810B6FBCFDCFB)
# - Google Calendar (connector:ccfg_google-calendar_DDDBAC03DE404369B74F32E78D)
# - Outlook (connector:ccfg_outlook_01K4BBCKRJKP82N3PYQPZQ6DAK)
# - GitHub (connector:ccfg_github_01K4B9XD3VRVD2F99YM91YTCAF)
#
# Configure these via the Integrations page in the app UI

# ===== Feature Flags (Optional) =====
# Enable/disable specific features during development
ENABLE_AR_MEASUREMENTS=true
ENABLE_AI_ANALYSIS=true
ENABLE_LIDAR_PROCESSING=true
ENABLE_PAYMENT_PROCESSING=true

# ===== Deployment Configuration =====
# Frontend URL (for CORS and redirects)
VITE_APP_URL=https://your-app.replit.app

# Port (default: 5000)
PORT=5000

# ===== End of Configuration =====
