{
  "id": "door_survey_v1",
  "name": "DoorSurvey Pro – Door Opening Survey Workflow",
  "version": 1,
  "steps": [
    {
      "key": "project",
      "label": "Project Details",
      "description": "Capture project context and applicable building standards.",
      "fields": [
        "project.name",
        "project.location",
        "project.customerId",
        "project.buildingType",
        "project.quoteType",
        "project.standards[]"
      ]
    },
    {
      "key": "mapping",
      "label": "Locate Opening",
      "description": "Map the opening to floor plan and assign unique ID.",
      "fields": [
        "opening.doorTag",
        "opening.floor",
        "opening.spaceName",
        "opening.openingType",
        "opening.handing"
      ]
    },
    {
      "key": "measurements",
      "label": "LiDAR / AR Measurements",
      "description": "Capture dimensional information using AR / LiDAR.",
      "fields": [
        "opening.measurements.roughWidthMm",
        "opening.measurements.roughHeightMm",
        "opening.measurements.clearWidthMm",
        "opening.measurements.headHeightMm",
        "opening.measurements.jambDepthMm",
        "opening.measurements.doorThicknessMm",
        "opening.measurements.sillHeightMm"
      ]
    },
    {
      "key": "door",
      "label": "Door Panel",
      "description": "Describe the installed or proposed door leaf.",
      "fields": [
        "opening.doorLeaf.leafType",
        "opening.doorLeaf.coreType",
        "opening.doorLeaf.fireRatingMinutes",
        "opening.doorLeaf.hasVisionLite",
        "opening.doorLeaf.visionLiteDescription",
        "opening.doorLeaf.manufacturer",
        "opening.doorLeaf.model"
      ]
    },
    {
      "key": "frame",
      "label": "Frame",
      "description": "Capture frame material, profile, anchorage, and condition.",
      "fields": [
        "opening.frame.material",
        "opening.frame.profile",
        "opening.frame.anchorType",
        "opening.frame.conditionScore",
        "opening.frame.notes"
      ]
    },
    {
      "key": "hardware",
      "label": "Hardware Set (Div 08 & Div 28)",
      "description": "Identify all hardware installed or required at the opening.",
      "fields": [
        "opening.hardware.hinges[]",
        "opening.hardware.lockFunction",
        "opening.hardware.lockset",
        "opening.hardware.exitDevice",
        "opening.hardware.closer",
        "opening.hardware.accessories[]",
        "opening.hardware.electrifiedHardware[]",
        "opening.hardware.electronicSecurity[]"
      ]
    },
    {
      "key": "compliance",
      "label": "Code Compliance",
      "description": "Automatically analyze the opening against codes and standards (Div 08 & Div 28).",
      "fields": [
        "opening.compliance.standardsChecked[]",
        "opening.compliance.passes",
        "opening.compliance.issues[]",
        "opening.compliance.notes"
      ]
    },
    {
      "key": "evidence",
      "label": "Photos & Evidence",
      "description": "Capture visual evidence for engineering review and record keeping.",
      "fields": [
        "opening.evidence.photos[]",
        "opening.evidence.videos[]",
        "opening.evidence.documents[]"
      ]
    },
    {
      "key": "engineering",
      "label": "Engineering Review",
      "description": "Provide a structured handoff to engineering.",
      "fields": [
        "opening.engineeringReview.status",
        "opening.engineeringReview.notes",
        "opening.engineeringReview.conflicts[]"
      ]
    },
    {
      "key": "quote",
      "label": "Quote Summary",
      "description": "Turn the survey into a priceable opening.",
      "fields": [
        "opening.quoteSummary.materialCost",
        "opening.quoteSummary.laborCost",
        "opening.quoteSummary.shippingCost",
        "opening.quoteSummary.marginPercent",
        "opening.quoteSummary.totalPrice",
        "opening.quoteSummary.optionLabel"
      ]
    },
    {
      "key": "review",
      "label": "Review & Save",
      "description": "Final review before saving the door survey.",
      "fields": [
        "project.*",
        "opening.*"
      ]
    }
  ]
}
