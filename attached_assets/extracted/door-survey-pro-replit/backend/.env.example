# FastAPI
SECRET_KEY=replace_me_with_random_32bytes
BASE_URL=https://<your-repl-URL>   # e.g., https://doorsurveypro.replit.app

# Atlassian (Jira/Confluence 3LO)
ATL_CLIENT_ID=...
ATL_CLIENT_SECRET=...
ATL_REDIRECT_URI=${BASE_URL}/oauth/atlassian/callback

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=${BASE_URL}/oauth/google/callback

# Microsoft (Graph) OAuth
MS_CLIENT_ID=...
MS_CLIENT_SECRET=...
MS_REDIRECT_URI=${BASE_URL}/oauth/ms/callback
