# Replit Integration Kit — Env Example
# General
PORT=3000
NODE_ENV=development

# Redis/BullMQ (for background jobs)
REDIS_URL=redis://localhost:6379

# CRM
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/oauth/callback

# Accounting
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/oauth/callback

# E-sign
DOCUSIGN_INTEGRATOR_KEY=
DOCUSIGN_SECRET=
DOCUSIGN_REDIRECT_URI=http://localhost:3000/api/integrations/docusign/oauth/callback

# Notifications
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Storage
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Calendars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Webhook secrets
WEBHOOK_SIGNING_SECRET=replace-me
