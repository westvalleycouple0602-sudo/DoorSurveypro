{
  "name": "dsp-express-drizzle-multitenant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate:generate": "drizzle-kit generate",
    "migrate:push": "drizzle-kit push"
  },
  "dependencies": {
    "express": "4.22.3",
    "zod": "^3.23.8",
    "drizzle-orm": "0.45.4",
    "drizzle-kit": "0.31.11",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "openid-client": "^5.6.5",
    "@aws-sdk/client-s3": "^3.674.0",
    "@aws-sdk/s3-request-presigner": "^3.674.0",
    "uuid": "11.1.1",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.6"
  },
  "overrides": {
    "uuid": "$uuid",
    "esbuild": "^0.25.0",
    "@tootallnate/once": "2.0.1"
  }
}
