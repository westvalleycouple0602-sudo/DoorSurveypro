{
  "info": {
    "name": "DoorSurvey Pro API",
    "_postman_id": "dsp-collection-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{TENANT}}"
          }
        ],
        "url": {
          "raw": "{{BASE}}/auth/me",
          "host": [
            "{{BASE}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "FloorPlan - Get",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{TENANT}}"
          }
        ],
        "url": {
          "raw": "{{BASE}}/api/floorplans/{{PLAN_ID}}",
          "host": [
            "{{BASE}}"
          ],
          "path": [
            "api",
            "floorplans",
            "{{PLAN_ID}}"
          ]
        }
      }
    },
    {
      "name": "Openings - Upsert",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{TENANT}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"floorPlanId\": \"{{PLAN_ID}}\",\n  \"code\": \"D-201\",\n  \"type\": \"Hinged\",\n  \"status\": \"planned\",\n  \"x\": 0.42,\n  \"y\": 0.58\n}"
        },
        "url": {
          "raw": "{{BASE}}/api/openings",
          "host": [
            "{{BASE}}"
          ],
          "path": [
            "api",
            "openings"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "BASE",
      "value": "http://localhost:3001"
    },
    {
      "key": "JWT",
      "value": "<token>"
    },
    {
      "key": "TENANT",
      "value": "<tenant-id>"
    },
    {
      "key": "PLAN_ID",
      "value": "<plan-id>"
    }
  ]
}